# Vector: receive syslog, make it readable, write it to OpenSearch.
#
# THIS IS A TEMPLATE. `make up` renders it to vector.rendered.yaml with envsubst
# and mounts that. Vector's own ${VAR} interpolation is NOT relied on: it left
# the placeholder text in place as the literal password, so every write got 401
# from OpenSearch while the credentials in the environment were perfectly good.
# Rendering makes what Vector reads exactly what is on disk, which is also what
# you can inspect when something is wrong.
#
# The readability is the point. Raw syslog is a timestamp, a host, a priority
# number and a blob, and a search UI over that is a grep with extra steps. So
# every message is normalised into the same small set of fields, the priority
# number is decoded into words a person can filter on, and anything that parsed
# badly is kept rather than dropped -- a log collector that silently discards
# what it could not parse is worse than no collector, because you cannot tell
# the difference between "nothing happened" and "nothing arrived".

data_dir: /var/lib/vector

sources:
  # Two listeners on the same port because devices differ and you do not get to
  # choose: most network gear sends UDP, rsyslog is usually configured for TCP,
  # and both are RFC3164 or RFC5424 depending on age.
  # timezone is the fallback for RFC3164 senders, which carry no offset at all.
  # Without it their local time is read as UTC and they land hours in the past --
  # which looks exactly like a host that has stopped sending, because a "last
  # hour" search excludes them. Hosts enrolled by the playbook send RFC5424 with
  # a real offset and ignore this; network gear that can only speak RFC3164
  # depends on it, so set it to the LAN's timezone.
  syslog_udp:
    type: syslog
    address: 0.0.0.0:514
    mode: udp
    timezone: ${ALDGATE_TIMEZONE}
  syslog_tcp:
    type: syslog
    address: 0.0.0.0:514
    mode: tcp
    timezone: ${ALDGATE_TIMEZONE}
  # RFC5425 syslog-over-TLS for anything that can do it.
  syslog_tls:
    type: syslog
    address: 0.0.0.0:6514
    mode: tcp
    timezone: ${ALDGATE_TIMEZONE}

  # SNMP traps, handed over by Telegraf.
  #
  # Vector cannot speak SNMP and Telegraf cannot produce these field names --
  # its OpenSearch output nests everything under the measurement name, so a trap
  # arrives as snmp_trap.ifIndex and tag.source while a syslog line is host and
  # message. That is two schemas sharing a UI, and it means a person filtering
  # by host sees half their network. So Telegraf receives the trap and posts it
  # straight here, and normalisation happens exactly once, in one language, for
  # everything that arrives.
  snmp_traps:
    type: http_server
    address: 0.0.0.0:8180
    # decoding.codec, NOT `encoding`. `encoding: json` is accepted here without
    # complaint and does nothing -- the body then arrives as a JSON *string* in
    # .message, which the transform below overwrites, so every trap indexed as a
    # complete document with every field empty. Nothing errored anywhere.
    decoding:
      codec: json
    path: /telegraf

transforms:
  normalise_snmp:
    type: remap
    inputs: [snmp_traps]
    drop_on_error: false
    drop_on_abort: false
    source: |
      # Telegraf posts one metric per request (use_batch_format = false), so the
      # payload IS the metric. If a {"metrics":[...]} envelope ever shows up --
      # someone turned batching back on -- say so in the document instead of
      # trying to be clever. The first version of this guessed, failed, and fell
      # back to an empty object: OpenSearch then held a perfectly well-formed
      # trap with every field blank, which is indistinguishable from a trap that
      # genuinely carried nothing. A loud wrong document beats a quiet one.
      # Belt and braces for the failure above: if the body ever arrives as an
      # unparsed string again, parse it here rather than writing an empty
      # document. And if it cannot be parsed, keep it and say so -- an ugly
      # document you can read is worth more than a tidy one that lost the event.
      if !exists(.tags) && is_string(.message) {
        parsed = parse_json(.message) ?? null
        if is_object(parsed) {
          . = object!(parsed)
        } else {
          .parse_error = "SNMP payload was not JSON"
        }
      }
      if exists(.metrics) {
        .parse_error = "batched payload; set use_batch_format = false in telegraf.conf"
        .raw = encode_json(.metrics)
      }

      .observer = "aldgate"
      .log_type = "snmp_trap"

      tags = object(.tags) ?? {}
      vars = object(.fields) ?? {}

      # --- host -----------------------------------------------------------
      # A trap identifies its sender by IP, which is not what anyone wants to
      # filter by. ALDGATE_DEVICE_MAP turns the ones you care about into names,
      # so `coreswitch` means the same thing here as it does in syslog. An
      # unmapped device keeps its IP rather than being dropped or called
      # "unknown" -- an address you can look up beats a placeholder.
      src = to_string(get(tags, ["source"]) ?? "") ?? ""
      names = parse_key_value("${ALDGATE_DEVICE_MAP}",
                key_value_delimiter: "=", field_delimiter: ",") ?? {}
      mapped = to_string(get(names, [src]) ?? "") ?? ""
      if mapped != "" {
        .host = downcase(mapped)
      } else if src != "" {
        .host = src
      } else {
        .host = "unknown"
      }
      # An unmapped device is an IP, and an IP's dots are not a domain.
      if match(.host, r'^\d+\.\d+\.\d+\.\d+$') {
        .host_short = .host
      } else {
        .host_short = replace(.host, r'\..*$', "")
      }
      if src != "" { .source_address = src }

      # --- program --------------------------------------------------------
      # The trap's name is the closest thing it has to "what generated this",
      # which is the question `program` answers for syslog.
      tn = to_string(get(tags, ["name"]) ?? "") ?? ""
      if tn == "" { tn = "snmp_trap" }
      .program = tn
      .oid = to_string(get(tags, ["oid"]) ?? "") ?? ""
      .mib = to_string(get(tags, ["mib"]) ?? "") ?? ""
      .snmp_version = to_string(get(tags, ["version"]) ?? "") ?? ""

      # --- severity -------------------------------------------------------
      # SNMP has no severity field at all: a link dropping and a device booting
      # arrive looking identical. Without this, "errors in the last hour" cannot
      # include the network, which is where errors are most often visible first.
      # Only the standard traps are classified; anything unrecognised is notice,
      # never silently important and never silently ignorable.
      by_name = {
        "linkdown": "error", "authenticationfailure": "warning",
        "coldstart": "warning", "warmstart": "notice", "linkup": "notice",
        "risingalarm": "warning", "fallingalarm": "notice"
      }
      sev = to_string(get(by_name, [downcase(.program)]) ?? "") ?? ""
      if sev == "" { sev = "notice" }
      .severity = sev
      ranks = {
        "emerg": 0, "alert": 1, "crit": 2, "error": 3,
        "warning": 4, "notice": 5, "info": 6, "debug": 7
      }
      sc = get(ranks, [.severity]) ?? 5
      if sc == null { sc = 5 }
      .severity_code = sc
      .facility = "snmp"

      # --- message --------------------------------------------------------
      # The varbinds ARE the content of a trap, and a document whose message is
      # "linkDown" tells you nothing about which link. Rendered as key=value on
      # one line so the message column reads like a log line, while the same
      # values stay individually searchable under snmp_vars.
      rendered = encode_key_value(vars)
      if rendered != "" {
        .message = .program + ": " + rendered
      } else {
        .message = .program
      }

      # The varbinds are stored as a LIST of name/index/value, not as an object
      # keyed by the varbind name, and that is not a style choice.
      #
      # A real trap names its variables with the instance appended after a dot:
      # ifIndex.2, ifOperStatus.2. A dot in a JSON key is a path in OpenSearch,
      # so snmp_vars.ifIndex.2 collides with the existing snmp_vars.ifIndex
      # (a long, from an earlier trap) and the WHOLE DOCUMENT is rejected with
      # 400 mapper_parsing_exception. Vector treats that as non-retriable and
      # drops it. Every hand-written test trap indexed perfectly; the first one
      # from an actual switch vanished, and nothing in Telegraf or OpenSearch
      # said so out loud -- only Vector's sink log, which nobody reads.
      #
      # A fixed shape also caps the mapping: one field per PORT per device
      # (ifIndex_2, ifIndex_5, ...) would otherwise grow the index mapping
      # without limit as the network grows.
      entries = []
      for_each(vars) -> |k, v| {
        key = to_string(k)
        parts = split(key, ".", limit: 2)
        nm = to_string(get(parts, [0]) ?? key) ?? key
        ix = to_string(get(parts, [1]) ?? "") ?? ""
        entries = push(entries, {"name": nm, "index": ix, "value": to_string(v) ?? ""})
      }
      if length(entries) > 0 { .snmp_vars = entries }

      # --- time -----------------------------------------------------------
      .received_at = now()
      ts = to_int(get(., ["timestamp"]) ?? 0) ?? 0
      if ts > 0 {
        .timestamp = from_unix_timestamp!(ts)
      } else {
        .timestamp = .received_at
      }

      del(.tags)
      del(.fields)
      del(.name)

  normalise:
    type: remap
    inputs: [syslog_udp, syslog_tcp, syslog_tls]
    # Never drop. A message that fails here still reaches OpenSearch with
    # whatever was understood, plus the reason it was hard.
    drop_on_error: false
    drop_on_abort: false
    source: |
      # VRL is strict about fallibility: del() and now() cannot fail, so `??` on
      # them is a compile error, while to_string() can fail and must be handled.
      # Written as explicit null checks rather than a chain of `??` for that
      # reason -- and because it is readable a year from now.
      .observer = "aldgate"
      .log_type = "syslog"

      # --- host -----------------------------------------------------------
      # Always present, because it is the first thing anyone filters by.
      h = del(.hostname)
      if h == null { h = del(.host) }
      if h == null { h = .source_ip }
      hs = to_string(h) ?? "unknown"
      if hs == "" { hs = "unknown" }
      .host = downcase(hs)

      # What YOU call the device wins over what it calls itself. The core switch
      # announces itself as "mikrotik" -- the factory identity -- so its logs
      # arrived under a name that matches neither its DNS name nor the name on
      # its SNMP traps, and searching for `coreswitch` found nothing while the
      # switch was sending perfectly well. Same map as the trap pipeline, keyed
      # on the sending address, so one device is one name everywhere. Hosts that
      # know their own name are not in the map and are left alone.
      names = parse_key_value("${ALDGATE_DEVICE_MAP}",
                key_value_delimiter: "=", field_delimiter: ",") ?? {}
      sip = to_string(.source_ip) ?? ""
      if sip != "" {
        named = to_string(get(names, [sip]) ?? "") ?? ""
        if named != "" { .host = downcase(named) }
      }

      # Strip the domain so `web01` and `web01.example.com` group together --
      # unless the host IS an address, where the dots are the value and cutting
      # at the first one leaves you filtering by "10".
      if match(.host, r'^\d+\.\d+\.\d+\.\d+$') {
        .host_short = .host
      } else {
        .host_short = replace(.host, r'\..*$', "")
      }

      # --- severity and facility ------------------------------------------
      # Words for filtering, plus a number so "warning or worse" is a range
      # query instead of a list of strings somebody has to remember.
      sev = to_string(.severity) ?? "unknown"
      .severity = downcase(sev)
      fac = to_string(.facility) ?? "unknown"
      .facility = downcase(fac)
      ranks = {
        "emerg": 0, "emergency": 0, "alert": 1, "crit": 2, "critical": 2,
        "err": 3, "error": 3, "warn": 4, "warning": 4,
        "notice": 5, "info": 6, "informational": 6, "debug": 7
      }
      sc = get(ranks, [.severity]) ?? 6
      if sc == null { sc = 6 }
      .severity_code = sc

      # --- program --------------------------------------------------------
      pr = del(.appname)
      if pr == null { pr = .program }
      if pr == null { pr = "unknown" }
      .program = to_string(pr) ?? "unknown"
      if exists(.procid) { .pid = to_string(del(.procid)) ?? "" }

      # --- message --------------------------------------------------------
      # One canonical text field. Discover shows a chosen field as the message
      # column, and it being reliably present is most of what readable means.
      m = .message
      if m == null { m = del(.body) }
      if m == null { m = "" }
      .message = to_string(m) ?? ""

      # --- time -----------------------------------------------------------
      # Both, because devices with a wrong clock are common: `timestamp` is what
      # the sender claimed, `received_at` is when it actually arrived here.
      .received_at = now()
      if !exists(.timestamp) { .timestamp = .received_at }

      # --- sender ---------------------------------------------------------
      if exists(.source_ip) { .source_address = del(.source_ip) }

sinks:
  opensearch:
    type: elasticsearch
    inputs: [normalise]
    endpoints: ["http://opensearch:9200"]
    # OpenSearch 2.x speaks the Elasticsearch 7.10 API. Pinned rather than
    # auto-detected: auto-detection reads the reported version (2.x) and can
    # decide it is talking to something much older than it is.
    api_version: v7
    auth:
      strategy: basic
      user: admin
      password: "${ALDGATE_ADMIN_PASSWORD}"
    mode: bulk
    bulk:
      index: "syslog-%Y.%m.%d"
    # A collector that loses what it received during a restart or a brief
    # OpenSearch outage is not a collector. Buffer to disk.
    buffer:
      type: disk
      max_size: 2147483648
      when_full: block
    request:
      retry_attempts: 25
    healthcheck:
      enabled: true

  # Traps go to their own index and their own disk buffer. Same fields, same
  # retention policy, separate queue -- so OpenSearch being slow to accept one
  # stream cannot stall the other.
  opensearch_snmp:
    type: elasticsearch
    inputs: [normalise_snmp]
    endpoints: ["http://opensearch:9200"]
    api_version: v7
    auth:
      strategy: basic
      user: admin
      password: "${ALDGATE_ADMIN_PASSWORD}"
    mode: bulk
    bulk:
      index: "snmp-%Y.%m.%d"
    buffer:
      type: disk
      max_size: 536870912
      when_full: block
    request:
      retry_attempts: 25
    healthcheck:
      enabled: true
