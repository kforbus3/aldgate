# Copy to .env and set a password. `make up` refuses to start without one,
# rather than booting with a default that nobody changes.
#
#   ALDGATE_ADMIN_PASSWORD=$(openssl rand -base64 24)
#
# OpenSearch 2.x enforces its own strength rules on this and fails to start with
# a clear message if it is too weak, so use the generator above.
ALDGATE_ADMIN_PASSWORD=

# Where the Dashboards UI listens. Default is every interface so you can reach
# it on the LAN; set 127.0.0.1 once Provenance is proxying it and you want the
# UI reachable only through Provenance.
ALDGATE_UI_BIND=0.0.0.0

# Set both of these only when serving Dashboards behind Provenance at a
# sub-path (see docs/provenance-integration.md):
#   ALDGATE_BASEPATH=/aldgate
#   ALDGATE_REWRITE_BASEPATH=true
ALDGATE_BASEPATH=
ALDGATE_REWRITE_BASEPATH=false

# Where the OpenSearch API listens. Loopback by default. Set 0.0.0.0 when
# Provenance runs on a different machine and needs to broker searches -- the
# security plugin is on, so the credential is what protects it either way.
ALDGATE_API_BIND=127.0.0.1

# Timezone assumed for senders that use RFC3164, which carries no offset (most
# network gear). Hosts enrolled by the playbook send RFC5424 with a real offset
# and ignore this. Wrong here means those devices' logs land hours off and a
# time-based search silently misses them.
ALDGATE_TIMEZONE=America/New_York

# Names for the devices that send SNMP traps. A trap identifies its sender only
# by IP, and "10.10.0.111" is not what you want to type into a host filter -- with
# this, a trap from the core switch is filed under `coreswitch`, exactly as its
# syslog is. Comma-separated, ip=name. Unlisted devices keep their IP.
ALDGATE_DEVICE_MAP=10.10.0.111=coreswitch,10.10.0.5=coreswitch10g,10.10.0.1=router

# How long to keep logs. Applied by `make bootstrap` as an ISM policy, so changing
# it and re-running is enough -- existing indices pick up the new window.
ALDGATE_RETENTION_DAYS=30

# Console tier credentials, GENERATED by `make bootstrap` -- leave these unset on a
# fresh install and it will fill them in.
#
# Provenance injects one of them per request, chosen from the person's Provenance
# role, so nobody types a collector password and no browser is ever sent one. Copy
# both into Provenance as PROV_ALDGATE_CONSOLE_VIEWER_PASSWORD and
# PROV_ALDGATE_CONSOLE_ADMIN_PASSWORD.
#
# ALDGATE_CONSOLE_VIEWER_PASSWORD=
# ALDGATE_CONSOLE_ADMIN_PASSWORD=
